recent_swaps = {}
SWAP_COOLDOWN_SECONDS = 10

wallet_locks = {}
swap_queue = asyncio.PriorityQueue()

async def register_helius_webhook(wallet_addresses):
    url = f"https://api.helius.xyz/v0/webhooks?api-key={HELIUS_API_KEY}"
    payload = {
        "webhookURL": HELIUS_WEBHOOK_URL,
        "wallets": wallet_addresses,
        "transactionTypes": ["TRANSFER", "SWAP", "TOKEN_MINT", "CREATE_POOL"],
        "webhookType": "enhanced"
    }
    response = requests.post(url, json=payload)
    print("Webhook registration response:", response.json())

async def sync_wallets_with_helius():
    try:
        with open(STORAGE_PATH, "r") as f:
            data = json.load(f)
        wallets = data.get("wallets", [])

        if not wallets:
            print("No wallets to sync.")
            return

        url = f"https://api.helius.xyz/v0/webhooks?api-key={HELIUS_API_KEY}"
        payload = {
            "webhookURL": HELIUS_WEBHOOK_URL,
            "wallets": wallets,
            "transactionTypes": ["TRANSFER", "SWAP", "TOKEN_MINT", "CREATE_POOL"],
            "webhookType": "enhanced"
        }
        response = requests.post(url, json=payload)
        print("Helius sync response:", response.json())

    except Exception as e:
        print(f"[Helius Sync Error]: {e}")

async def enqueue_swap(wallet, token, priority=1):
    now = time.time()
    if token in recent_swaps and now - recent_swaps[token] < SWAP_COOLDOWN_SECONDS:
        return
    recent_swaps[token] = now
    await swap_queue.put((priority, wallet, token))

async def swap_worker():
    while True:
        priority, wallet, token = await swap_queue.get()
        if wallet not in wallet_locks:
            wallet_locks[wallet] = asyncio.Lock()
        async with wallet_locks[wallet]:
            try:
                success = await execute_swap(wallet, token)
                if success:
                    await bot.send_message(ALERT_CHAT_ID, f"✅ Swap executed on token {token} for wallet {wallet}")
                    asyncio.create_task(schedule_auto_sell(wallet, token, delay=60))
                else:
                    await bot.send_message(ALERT_CHAT_ID, f"❌ Swap failed for token {token} and wallet {wallet}")
            except Exception as e:
                await bot.send_message(ALERT_CHAT_ID, f"🚨 Error during swap: {e}")
            finally:
                swap_queue.task_done()

async def init_helius_webhook_listener():
    from fastapi import FastAPI, Request
    from fastapi.responses import JSONResponse
    import uvicorn

    app = FastAPI()

    @app.post("/webhook")
    async def webhook_listener(request: Request):
        body = await request.json()
        events = body.get("events", [])
        for event in events:
            event_type = event.get("type")
            token = event.get("nativeMint") or event.get("mint")
            source_wallet = event.get("source") or event.get("owner") or "global"

            if event_type in ["CREATE_POOL", "TOKEN_MINT"] and token:
                await enqueue_swap(source_wallet, token)
        return JSONResponse(content={"status": "ok"})

    config = uvicorn.Config(app, host="0.0.0.0", port=8000, log_level="info")
    server = uvicorn.Server(config)
    await server.serve()

