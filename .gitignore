@dp.message(InputState.confirm_sim_delete)
async def confirm_sim_wallet_delete(message: types.Message, state: FSMContext):
    # Clean the wallet address (remove spaces and convert to lowercase for consistency)
    address = message.text.strip()  # Assuming Solana addresses are lowercase

    # Log the address being attempted for deletion (for debugging)
    print(f"Attempting to delete wallet address: {address}")

    # Check if the address is in the list of simulation wallets
    wallets = list_sim_wallets()  # This function should return a list of all sim wallets
    print(f"Current simulation wallets: {wallets}")  # Log current list for debugging

    if address in wallets:
        # If the wallet is found, proceed with deletion
        if delete_sim_wallet_and_logs(address):  # Your function to remove wallet and logs
            await message.answer(f"✅ Deleted simulation wallet <code>{address}</code> and its logs.")
        else:
            await message.answer(f"❌ An error occurred while deleting wallet <code>{address}</code>.")
    else:
        # If the wallet address is not found in the list
        await message.answer(f"❌ Simulation wallet <code>{address}</code> not found in the watchlist.")

    await state.clear()


