@dp.message(InputState.add_wallet)
async def receive_add_wallet(message: types.Message, state: FSMContext):
    address = message.text.strip()
    
    wallets = list_wallets()
    print("Before adding, wallets:", wallets)  # DEBUG

    if len(wallets) >= 15:
        await message.answer("⚠️ You can only add up to 15 wallets. Please remove one before adding a new one.")
    elif add_wallet(address, STORAGE_PATH):
        wallets = list_wallets()
        print("After adding, wallets:", wallets)  # DEBUG
        await message.answer(f"✅ Wallet <code>{address}</code> added to watchlist.")
    else:
        await message.answer(f"⚠️ Wallet <code>{address}</code> already exists.")
    
    await state.clear()




