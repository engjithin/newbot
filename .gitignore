    await callback.message.edit_text("🔫 Sniping Settings Menu:", reply_markup=sniping_kb)
    await callback.answer()

@dp.callback_query(F.data == "connect_wallet")
async def handle_connect_wallet(callback: types.CallbackQuery, state: FSMContext):
    await state.set_state(InputState.base_wallet_key)
    await callback.message.answer("🔐 Please send your base wallet private key:")
    await callback.answer()

@dp.message(InputState.base_wallet_key)
async def receive_base_wallet_key(message: types.Message, state: FSMContext):
    key = message.text.strip()
    set_base_wallet(key)
    await message.answer("✅ Base wallet connected successfully.")
    await state.clear()

